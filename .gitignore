node_modules/
npm-debug.log*
.DS_Store
.auth/
playwright-report/
playwright-report-emulator/
playwright-report-appium/
test-results/
test-results-appium/
# Baseline results ARE tracked (overwritten each run)
!tests/emulator/baseline/
*.js.map
# Compiled TypeScript output (built by tsc, not checked in)
public/app.js
public/modules/*.js
# Native APKs — built by flutter, placed in public/ for container deploy, not checked in
public/*.apk
# Generated APK install landing page (regenerated every release by gen-apk-install-page.sh)
public/native.html
# Persistent native distribution dir (#700) — bind-mounted into prod; holds the
# built APKs + install page so they survive container recreate / public hot-push.
native-dist/
test-data/
.claude/worktrees/
.claude/settings.local.json
test-history/
.traces/

# lsmcp cache
.lsmcp/cache

# process coredumps (can contain in-memory secrets — never commit)
core
core.*
*.core
