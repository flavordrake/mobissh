node_modules/
npm-debug.log*
.DS_Store
.auth/
playwright-report/
playwright-report-emulator/
playwright-report-appium/
test-results/
test-results-appium/
# Baseline results ARE tracked (overwritten each run)
!tests/emulator/baseline/
*.js.map
# Compiled TypeScript output (built by tsc, not checked in)
public/app.js
public/modules/*.js
# Native APKs — built by flutter, placed in public/ for container deploy, not checked in
public/*.apk
# macOS app bundles + Play AAB + the macOS publish manifest — same deal: build
# output staged in public/ for serving, never source. Untracked-but-unignored
# left ~70MB of zips one `git add -A` away from the history.
public/*.zip
public/*.aab
public/macos-latest.json
# Generated APK install landing page (regenerated every release by gen-apk-install-page.sh)
public/native.html
# Persistent native distribution dir (#700) — bind-mounted into prod; holds the
# built APKs + install page so they survive container recreate / public hot-push.
native-dist/
test-data/
.claude/worktrees/
.claude/settings.local.json
# test-history/: recordings/screenshots stay local (LFS clone failures, efeda3c).
# Only the coverage .md reports are committed (#1152); raw lcov is multi-MB, local only.
test-history/*
!test-history/coverage/
test-history/coverage/**/*.lcov
test-history/coverage/**/*.info
# #1101: the #589 integration-suite baselines are the gate's expected-pass
# record — markdown only, same deal as coverage (raw per-test logs stay local).
!test-history/integration-baseline/
.traces/
# vitest --coverage output (scripts/ts-coverage.sh); native/coverage/ is ignored in native/.gitignore
/coverage/

# lsmcp cache
.lsmcp/cache

# process coredumps (can contain in-memory secrets — never commit)
core
core.*
*.core
