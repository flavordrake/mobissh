<?xml version="1.0" encoding="utf-8"?>
<!-- #1107: the hardened HTML viewer renders a single self-contained document
     via loadHtmlString (no loopback server, no origin, no network). With the
     127.0.0.1 loopback resolver gone there is no cleartext exception to make:
     ALL cleartext HTTP stays blocked (targetSdk 28+ default), for every host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
