{
  "name": "mobissh",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "start:ssh": "BASE_PATH=/ssh PORT=8081 node server/index.js",
    "server": "bash scripts/server-ctl.sh",
    "server:ensure": "bash scripts/server-ctl.sh ensure",
    "server:status": "bash scripts/server-ctl.sh status",
    "setup:nginx": "sudo bash scripts/setup-nginx.sh",
    "prepare": "git config core.hooksPath hooks",
    "lint": "eslint public/ server/ server-feedback/",
    "lint:fix": "eslint --fix public/ server/ server-feedback/",
    "test": "bash scripts/native-fast-gate.sh",
    "test:infra": "bash scripts/test-infra.sh",
    "test:sshd:up": "docker compose -f docker-compose.test.yml up -d test-sshd",
    "test:sshd:down": "docker compose -f docker-compose.test.yml down",
    "semgrep": "semgrep --config .semgrep/rules.yml --config p/javascript server/ server-feedback/ --no-git-ignore --error --severity WARNING"
  },
  "devDependencies": {
    "@mizchi/lsmcp": "^0.9.4",
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  }
}
