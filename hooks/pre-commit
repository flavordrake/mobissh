#!/bin/sh
# MobiSSH pre-commit hook
#
# 1. Runs ESLint on staged JS files
# 2. Runs semgrep on staged JS files
#
# #1205: the frozen-baseline block (and .semgrep/playwright-traps.yml, which
# enforced the same policy) guarded *-baseline.spec.* files. Every one of them
# lived in the PWA's Playwright suites and went with them; zero remain.

set -e

# Collect staged JS files under our lint targets.
# #1205: src/ (TypeScript) and tests/ (Playwright) went with the PWA; what is
# left to lint is the server, the feedback service, the two static scripts the
# install page loads, and the infra tests.
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACMR | grep '^\(public\|server\|server-feedback\|test\)/.*\.js$' || echo "")

if [ -z "$STAGED_JS" ]; then
  exit 0
fi

echo "Running ESLint on staged files..."
npx eslint --max-warnings=-1 $STAGED_JS

# Run semgrep on staged JS files (if semgrep is available)
if command -v semgrep >/dev/null 2>&1; then
  echo "Running semgrep on staged JS files..."
  semgrep --config .semgrep/rules.yml $STAGED_JS --no-git-ignore --error --severity WARNING
fi
